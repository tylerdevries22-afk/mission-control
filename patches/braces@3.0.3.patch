new file mode 100644
--- /dev/null
+++ b/lib/depth-guard.js
@@ -0,0 +1,21 @@
+'use strict';
+
+// GHSA-vfj7-8cjw-p6xm: bound parsed and caller-supplied ASTs before recursive walkers.
+const MAX_DEPTH = 128;
+const MAX_NODES = 65536;
+const assertDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  let visited = 0;
+  while (pending.length > 0) {
+    const { node, depth } = pending.pop();
+    if (depth > MAX_DEPTH || ++visited > MAX_NODES) {
+      throw new SyntaxError('Brace AST exceeds safe traversal limits');
+    }
+    if (!node || !Array.isArray(node.nodes)) continue;
+    if (node.nodes.length + pending.length > MAX_NODES) {
+      throw new SyntaxError('Brace AST exceeds safe traversal limits');
+    }
+    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+  }
+};
+module.exports = { assertDepth, MAX_DEPTH };
